# Environment files (never commit secrets)
.env
.env.*
!.env.example

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# TypeScript build info (machine-local incremental build cache)
*.tsbuildinfo

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Wrangler local state
.wrangler/

# Supabase CLI runtime cache (machine-local, regenerated on every CLI run)
supabase/.temp/

# Deno lockfile — regenerated locally on `deno test`/`deno check`; the repo does
# not track it (edge functions resolve deps at deploy time). Do not commit.
deno.lock
